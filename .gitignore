# Pulled in on demand for headless Playwright verification runs; never part
# of the shipped static site (this app has no build step and no runtime
# dependencies — see CLAUDE.md's no-CDN/self-contained posture).
node_modules/

# stray one-off scratch scripts
.scratch_*.js

# Generated by `npm install` when pulling in Playwright for a verification
# run; same on-demand dev-tooling category as node_modules/ above. The
# committed package.json is what defines `npm test` — the install artifacts
# it produces are deliberately not tracked.
package-lock.json
